# SparkXFlow Nexus — configuration template
#
# Copy to `.env` and fill in. `.env` is git-ignored and must never be committed.
# Values below are safe local-development defaults; the blank ones need you.
# Backend reads these with the SPARKX_ prefix (app/core/config.py).

# ---------------------------------------------------------------- application
SPARKX_APP_ENV=development
SPARKX_PUBLIC_BASE_URL=http://localhost:8000
SPARKX_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# ------------------------------------------------------------------ database
# Used by scripts running on the host. Compose overrides the host part for
# containers, so the same file serves both.
SPARKX_DATABASE_URL=postgresql+asyncpg://sparkx:sparkx@localhost:5432/sparkxflow
SPARKX_DB_POOL_SIZE=5
SPARKX_DB_MAX_OVERFLOW=10

# Docker Compose provisions PostgreSQL itself with these credentials, and they
# must agree with the URL above.
POSTGRES_USER=sparkx
POSTGRES_PASSWORD=sparkx
POSTGRES_DB=sparkxflow

# ---------------------------------------------------------------------- redis
SPARKX_REDIS_URL=redis://localhost:6379/0
SPARKX_CELERY_BROKER_URL=redis://localhost:6379/1
SPARKX_CELERY_RESULT_BACKEND=redis://localhost:6379/2

# No Redis/Memurai available? Set true to execute tasks inline instead of
# queueing them. Development only, blocks the caller, refused in production.
SPARKX_RUN_JOBS_SYNCHRONOUSLY=false

# ------------------------------------------------------------------ auth/session
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SPARKX_SIGNING_SECRET=
SPARKX_SESSION_TTL_HOURS=12
SPARKX_COOKIE_SECURE=false
SPARKX_COOKIE_SAMESITE=lax

# ------------------------------------------------------------------- discovery
# Self-hosted SearXNG started by docker-compose.
SPARKX_SEARXNG_BASE_URL=http://localhost:8080
SPARKX_SEARXNG_TIMEOUT_SECONDS=20
SPARKX_SEARXNG_MAX_PAGES=3
SPARKX_SEARXNG_RESULTS_PER_PAGE=20

# Secret used by SearXNG internally. Generate any random 32+ byte value.
SEARXNG_SECRET=

# --------------------------------------------------------------------- geography
# ISO 3166-1 alpha-2. Drives phone-number parsing for numbers found without a
# country code. India-first, but changeable without a schema change.
SPARKX_DEFAULT_REGION=IN

# ------------------------------------------------------------------- retention
SPARKX_RETENTION_RAW_DAYS=15
SPARKX_RETENTION_ENRICHMENT_DAYS=15

# ---------------------------------------------------------------------- logging
SPARKX_LOG_LEVEL=INFO
SPARKX_LOG_JSON=true

# --------------------------------------------------------------------- storage
SPARKX_EXPORT_DIR=var/exports

# ------------------------------------------------------------------- frontend
# Read by the Next.js app, not the backend.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
